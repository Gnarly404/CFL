# Copy to .env.production (or .env.staging and build with `vite build --mode staging`).
# These are PUBLIC Firebase web-app settings (Firebase console > Project settings > Your apps).
# Never put server secrets (SMTP passwords, service accounts) in VITE_* variables.
VITE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Must match REGION in functions/src/lib/config.js
VITE_FUNCTIONS_REGION=europe-west1
