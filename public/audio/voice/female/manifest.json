   "seconds": 1.94
  },
  "411bea55": {
   "text": "Our school is on this street.",
   "file": "411bea55-en-us-lessac-mediu-108.mp3",
   "seconds": 1.76
  },
  "4626414d": {
   "text": "She follows a recipe to bake a cake.",
   "file": "4626414d-en-us-lessac-mediu-108.mp3",
   "seconds": 2.2
  },
  "481a0b42": {
   "text": "He goes to the bank on Friday.",
