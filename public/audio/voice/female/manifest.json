  },
  "7c3f812f": {
   "text": "morning",
   "file": "7c3f812f-en-us-lessac-mediu-108.mp3",
   "seconds": 0.76
  },
  "82db4d21": {
   "text": "late",
   "file": "82db4d21-en-us-lessac-mediu-108.mp3",
   "seconds": 0.72
  },
  "83d7a1bb": {
   "text": "My cousin lives in another town.",
   "file": "83d7a1bb-en-us-lessac-mediu-108.mp3",
   "seconds": 2.02
  },
  "8cac251b": {
   "text": "I wait at the station for the train.",
   "file": "8cac251b-en-us-lessac-mediu-108.mp3",
   "seconds": 2.02
  },
  "90e949a5": {
   "text": "Tell me about your daily routine.",
   "file": "90e949a5-en-us-lessac-mediu-108.mp3",
   "seconds": 1.98
  },
  "90f6fbd0": {
   "text": "library",
   "file": "90f6fbd0-en-us-lessac-mediu-108.mp3",
   "seconds": 0.94
  },
  "922c8d9c": {
   "text": "We have lunch at school.",
   "file": "922c8d9c-en-us-lessac-mediu-108.mp3",
   "seconds": 1.51
  },
  "97bea7a1": {
   "text": "We buy vegetables at the market.",
   "file": "97bea7a1-en-us-lessac-mediu-108.mp3",
   "seconds": 1.98
  },
  "9a32f866": {
   "text": "breakfast",
   "file": "9a32f866-en-us-lessac-mediu-108.mp3",
   "seconds": 0.9
  },
  "9aafcd45": {
   "text": "Choose a skill. Short, regular practice works best, so even ten minutes today will help.",
   "file": "9aafcd45-en-us-lessac-mediu-108.mp3",
   "seconds": 5.87
  },
  "9d12da41": {
   "text": "Our neighbour says hello every morning.",
   "file": "9d12da41-en-us-lessac-mediu-108.mp3",
   "seconds": 2.16
  },
  "9db7efdb": {
   "text": "Good morning. I would like two kilos of rice and one litre of milk, please. Of course. That will be four hundred and fifty shillings. Here you are. Thank you, and have a nice day.",
   "file": "9db7efdb-en-us-lessac-mediu-108.mp3",
   "seconds": 11.92
  },
  "9e2ced27": {
   "text": "My brother plays football.",
   "file": "9e2ced27-en-us-lessac-mediu-108.mp3",
   "seconds": 1.84
  },
  "ab285923": {
   "text": "What is your favourite food, and why do you like it?",
   "file": "ab285923-en-us-lessac-mediu-108.mp3",
   "seconds": 3.02
  },
  "ac2174f1": {
   "text": "Good afternoon. Ready to improve your English today? Pick up where you left off, or choose a skill to practise.",
   "file": "ac2174f1-en-us-lessac-mediu-108.mp3",
   "seconds": 7.38
  },
  "ac247217": {
   "text": "afternoon",
   "file": "ac247217-en-us-lessac-mediu-108.mp3",
   "seconds": 0.97
  },
  "acf83cb2": {
   "text": "To get to the hospital, walk straight along this street for two hundred metres. Turn left at the bank. The hospital is next to the library, on the right. It takes about five minutes.",
   "file": "acf83cb2-en-us-lessac-mediu-108.mp3",
   "seconds": 10.73
  },
  "aed72c13": {
   "text": "station",
   "file": "aed72c13-en-us-lessac-mediu-108.mp3",
   "seconds": 0.79
  },
  "b0fee263": {
   "text": "father",
   "file": "b0fee263-en-us-lessac-mediu-108.mp3",
   "seconds": 0.72
  },
  "b5f82e71": {
   "text": "market",
   "file": "b5f82e71-en-us-lessac-mediu-108.mp3",
   "seconds": 0.76
  },
  "c15ba869": {
   "text": "Good evening. Ready to improve your English today? Pick up where you left off, or choose a skill to practise.",
   "file": "c15ba869-en-us-lessac-mediu-108.mp3",
   "seconds": 7.02
  },
  "c35176ad": {
   "text": "I eat breakfast at seven.",
   "file": "c35176ad-en-us-lessac-mediu-108.mp3",
   "seconds": 1.73
  },
  "c3b8342f": {
   "text": "evening",
   "file": "c3b8342f-en-us-lessac-mediu-108.mp3",
   "seconds": 0.79
  },
  "c7ba54d3": {
   "text": "She reads at the library after class.",
   "file": "c7ba54d3-en-us-lessac-mediu-108.mp3",
   "seconds": 2.23
  },
  "c7f8afb0": {
   "text": "My mother cooks dinner every evening.",
   "file": "c7f8afb0-en-us-lessac-mediu-108.mp3",
   "seconds": 2.12
  },
  "c873861e": {
   "text": "What do you usually do in the evening?",
   "file": "c873861e-en-us-lessac-mediu-108.mp3",
   "seconds": 2.27
  },
  "cdd836db": {
   "text": "Tell me about a place where you buy food.",
   "file": "cdd836db-en-us-lessac-mediu-108.mp3",
   "seconds": 2.3
  },
  "ceccb674": {
   "text": "Dinner is ready at eight.",
   "file": "ceccb674-en-us-lessac-mediu-108.mp3",
   "seconds": 1.48
  },
  "cf1ef61f": {
   "text": "lunch",
   "file": "cf1ef61f-en-us-lessac-mediu-108.mp3",
   "seconds": 0.9
  },
  "d5ad2377": {
   "text": "I study in the morning.",
   "file": "d5ad2377-en-us-lessac-mediu-108.mp3",
   "seconds": 1.62
  },
  "db6876e0": {
   "text": "My sister is two years older than me.",
   "file": "db6876e0-en-us-lessac-mediu-108.mp3",
   "seconds": 2.2
  },
  "e232afd1": {
   "text": "The hospital is near the bus station.",
   "file": "e232afd1-en-us-lessac-mediu-108.mp3",
   "seconds": 2.12
  },
  "e5ec86e9": {
   "text": "What do you like doing in your free time?",
   "file": "e5ec86e9-en-us-lessac-mediu-108.mp3",
   "seconds": 2.12
  },
  "ec7e97cf": {
   "text": "recipe",
   "file": "ec7e97cf-en-us-lessac-mediu-108.mp3",
   "seconds": 0.9
  },
  "f1f159bf": {
   "text": "He was late for the lesson.",
   "file": "f1f159bf-en-us-lessac-mediu-108.mp3",
   "seconds": 1.58
  },
  "f2036da9": {
   "text": "The children are thirsty on a hot day.",
