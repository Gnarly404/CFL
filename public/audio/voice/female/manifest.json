   "seconds": 0.72
  },
  "2acbb175": {
   "text": "Hello Sara, this is Peter. I cannot come to class on Tuesday because I have a doctor's appointment. I will come on Wednesday at ten o'clock instead. Please tell the teacher. Thank you. Goodbye.",
   "file": "2acbb175-en-us-lessac-mediu-108.mp3",
   "seconds": 12.46
  },
