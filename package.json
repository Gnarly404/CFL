{
  "name": "cfl",
  "version": "2.0.0-foundation.1",
  "private": true,
  "description": "Centre of Foreign Learning: public site, student portal, admin tools, on Firebase.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && npm --prefix functions run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-cfl \"vitest run --config vitest.rules.config.js\"",
    "check:routes": "node scripts/check-routes.mjs",
    "verify": "npm run check:shared && npm run lint && npm test && npm run build && npm run check:routes",
    "emulators": "firebase emulators:start --project demo-cfl --only auth,functions,firestore,storage",
    "seed": "node scripts/seed-emulator.mjs",
    "bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "sync:shared": "node scripts/sync-shared.mjs",
    "check:shared": "node scripts/sync-shared.mjs --check"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.2",
    "firebase": "^9.14.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "^2.0.7",
    "eslint": "10.12.0",
    "firebase-tools": "^14.23.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "parse5": "8.0.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
