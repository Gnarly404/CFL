# Copy to .env.development for local dev (see README "First run").
VITE_USE_EMULATORS=true
VITE_EMULATOR_HOST=127.0.0.1
VITE_FUNCTIONS_REGION=europe-west1
VITE_FIREBASE_PROJECT_ID=demo-cfl
# Emulator-friendly placeholders (not used against production when VITE_USE_EMULATORS=true).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-cfl.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-cfl.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Set for deployed environments after registering the web app with Firebase App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
