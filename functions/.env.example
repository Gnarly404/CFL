# Copy to functions/.env.<projectId> (deploy) or functions/.env.local (emulator). Non-secret settings only.
APP_BASE_URL=https://your-domain.example
MAIL_TRANSPORT=smtp
MAIL_FROM=Centre of Foreign Learning <admissions@your-domain.example>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=admissions@your-domain.example
IP_HASH_SALT=change-me-to-a-random-string
# The SMTP password is a SECRET: run `firebase functions:secrets:set SMTP_PASS`
