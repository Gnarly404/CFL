# Copy to functions/.env.<projectId> (deploy) or functions/.env.local (emulator). Non-secret settings only.
APP_BASE_URL=https://your-domain.example
MAIL_TRANSPORT=smtp
MAIL_FROM=Centre of Foreign Learning <admissions@your-domain.example>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=admissions@your-domain.example
# Required. Use a random value of 16+ characters, for example: openssl rand -hex 24
# A deploy with no value stops and asks for one. A short or placeholder value deploys but every
# request that rate-limits fails until it is fixed, so check it after deploying.
# Changing it later only resets rate-limit counters.
IP_HASH_SALT=
# The SMTP password is a SECRET: run `firebase functions:secrets:set SMTP_PASS`
